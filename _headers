# Los borradores del blog: la cola de artículos que publica cada día
# herramientas/publicar_blog.py. Se publican porque Pages sirve la raíz, y
# llevan el canonical a /blog/ y ningún noindex, así que Google podía
# indexarlos antes de tiempo (auditoría 02-10-2026, INV-08, SEG-28 y OBS-21).
#
# Por CABECERA y no con <meta>: publicar_blog.py mueve el archivo tal cual a
# blog/, y una meta noindex dejaría sin indexar el artículo ya publicado.
# Tampoco con Disallow en robots.txt: impide al buscador leer el noindex y
# además anuncia la ruta.
#
# ⚠️ Comprobar después de desplegar que la cabecera sale de verdad (ver arriba:
# Cloudflare ignora sin avisar los patrones que no reconoce).
/borradores-blog/*
  X-Robots-Tag: noindex, nofollow

# turnstile.js lo importa suscripcion.js (no el HTML), así que su `?v=` va en
# ese import: al tocar turnstile.js hay que subirlo allí. La caché corta de
# aquí es la otra red.
/turnstile.js
  Cache-Control: public, max-age=60, must-revalidate

# supabase-js, servido desde aquí y no desde esm.sh (auditoría 02-10-2026,
# SEG-07). Lleva la versión en el NOMBRE, así que se puede cachear un año: una
# versión nueva es otro fichero.
/vendor/supabase-js-2.39.8.js
  Cache-Control: public, max-age=31536000, immutable

# Los iconos de Font Awesome, recortados a los que usa la web y servidos desde
# aquí (auditoría 02-10-2026, REN-12 y SEG-53). Las fuentes llevan una huella
# en el nombre y no necesitan regla; la hoja, sí, porque se llama siempre igual.
# Se regenera con herramientas/iconos.py.
/vendor/fontawesome/iconos.css
  Cache-Control: public, max-age=60, must-revalidate

# Las tipografías, servidas desde aquí y no desde Google Fonts (auditoría
# 02-10-2026, REN-58). Mismo trato que los iconos: las fuentes llevan huella en
# el nombre; las hojas, no.
/vendor/fuentes/tipografias.css
  Cache-Control: public, max-age=60, must-revalidate
/vendor/fuentes/tipografias-mono.css
  Cache-Control: public, max-age=60, must-revalidate

